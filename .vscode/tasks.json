{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "python3: Run this module locally.",
			"type": "shell",
			"options": {
				"cwd": "${fileDirname}",
			},
			"command": "python3 -u ${file}",
			"group": "build",
		},
		{
			"label": "python3: Run PYRIGHT on whole project.",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}",
			},
			"command": "pyright",
			"group": "build",
		},
		{
			"label": "python3: RUFF: Fix imports sorting and formatting in this module.",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}",
			},
			"command": "ruff check --select I --fix ${file}",
			"group": "build",
		},
		{
			"label": "python3: RUFF: Fix imports sorting and formatting in all modules.",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}",
			},
			"command": "ruff check --select I --fix .",
			"group": "build",
		},
		{
			"label": "python3: Run PYTEST on this module.",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}",
			},
			"command": "pytest ${file}",
			"group": "build",
		},
		{
			"label": "python3: Run PYTEST on whole project.",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}",
			},
			"command": "pytest",
			"group": "build",
		},
	]
}